# Copy to .env, generate a random token, and replace the LAN address/hostname.
NOVA_DEVICE_TOKEN=replace-with-at-least-32-random-bytes
NOVA_LAN_ADDRESS=192.168.1.20
NOVA_PUBLIC_HOST=nova-sentinel.local

# Optional policy/service settings. This value must remain valid one-line JSON.
NOVA_SERVICES_JSON=[]
NOVA_CPU_WARNING_TENTHS=850
NOVA_CPU_CRITICAL_TENTHS=950
NOVA_MEMORY_WARNING_TENTHS=850
NOVA_MEMORY_CRITICAL_TENTHS=950
NOVA_DISK_WARNING_TENTHS=800
NOVA_DISK_CRITICAL_TENTHS=900
NOVA_RATE_LIMIT_PER_MINUTE=30
